<!DOCTYPE html>

<html>
<head>
	<meta name="viewport" content="width=device-width" />
	<title>@ViewBag.Title</title>
	<!--CSS-->
	<title>CHEFER - Chef Website Template</title>
	<meta content="width=device-width, initial-scale=1.0" name="viewport" />
	<meta content="Free HTML Templates" name="keywords" />
	<meta content="Free HTML Templates" name="description" />

	<!-- Favicon -->
	<link href="~/Chefer-1.0.0/img/favicon.ico" rel="icon" />

	<!-- Google Web Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Emblema+One&family=Poppins:wght@400;600&display=swap"
		  rel="stylesheet" />

	<!-- Icon Font Stylesheet -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.0/css/all.min.css" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

	<!-- Libraries Stylesheet -->
	<link href="~/Chefer-1.0.0/lib/animate/animate.min.css" rel="stylesheet" />
	<link href="~/Chefer-1.0.0/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />

	<!-- Customized Bootstrap Stylesheet -->
	<link href="~/Chefer-1.0.0/css/bootstrap.min.css" rel="stylesheet" />

	<!-- Template Stylesheet -->
	<link href="~/Chefer-1.0.0/css/style.css" rel="stylesheet" />
</head>
<body>
	<!-- Header Start -->
	@await Html.PartialAsync("HeaderView")
	<!-- Header End -->
	<div>
		@RenderBody()
	</div>
	<!-- Footer Start -->
	@await Html.PartialAsync("_FooterView")
	<!-- Footer End -->
	<!-- JavaScript Libraries -->
	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/Chefer-1.0.0/lib/wow/wow.min.js"></script>
	<script src="~/Chefer-1.0.0/lib/easing/easing.min.js"></script>
	<script src="~/Chefer-1.0.0/lib/waypoints/waypoints.min.js"></script>
	<script src="~/Chefer-1.0.0/lib/counterup/counterup.min.js"></script>
	<script src="~/Chefer-1.0.0/lib/owlcarousel/owl.carousel.min.js"></script>

	<!-- Template Javascript -->
	<script src="~/Chefer-1.0.0/js/main.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
