@model List<HangHoaVM>
@{
    ViewData["Title"] = "Search";
}

<h1>Search</h1>
<form asp-action="Search">
    Tìm gì: <input name="Keyword" placeholder="Tìm gì?" />
    <br>
	Giá từ: <input name="MinPrice" type="number" placeholder="Giá từ" />
	đền: <input name="MaxPrice" type="number" placeholder="đến" />
    <button type="submit">Tìm</button>
</form>

@if(Model != null)
{
    if(Model.Count == 0)
    {
        <p>Không có kết quả nào được tìm thấy.</p>
    }
    else
    {
        <p>Tìm thấy @Model.Count kết quả.</p>
        @foreach(var item in Model)
        {
            <div>
                <h3>@item.TenHh</h3>
                <p>Giá: @item.DonGia.ToString("C")</p>
                <p>@item.TenLoai - @item.TenNhaCungCap</p>
            </div>
		}
    }
}
