@model List<Lab02.Models.Course>

@{
	ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
	<a asp-action="Create">Create New</a>
</p>
<table class="table">
	<thead>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@item.Id
				</td>
				<td>
					@item.Name
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Credits)
				</td>
				<td>
					@item.TotalHours (@item.TheoryHours LT + @item.PracticeHours TH)
				</td>
				<td>
					<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
					<button type="button" class="btn-danger btn" onclick="confirmDeleteCourse(@item.Id, '@item.Name');">Delete</button>
				</td>
			</tr>
		}
	</tbody>
</table>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
	function confirmDeleteCourse(courseId, name){
	//alert("Dang chọn xóa " + courseId);
	Swal.fire({
		title: `<strong>Xóa <u>${name}</u></strong>`,
		icon: "warning",
		html: "Bạn chắc xóa không?",
		showCloseButton: true,
		showCancelButton: true,
		focusConfirm: false,
		confirmButtonText: `
		<i class="fa fa-thumbs-up"></i> Great!
		`,
		confirmButtonAriaLabel: "Xóa ngay",
		cancelButtonText: `
		<i class="fa fa-thumbs-down"></i>
		`,
		cancelButtonAriaLabel: "Thumbs down"
		});
	}
</script>
